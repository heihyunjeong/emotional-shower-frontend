{
  "name": "react-bbs",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^0.27.2",
    "react": "^18.2.0",
    "react-axios": "^2.0.6",
    "react-dom": "^18.2.0",
    "react-js-pagination": "^3.0.3",
    "react-router": "^6.3.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "recoil": "^0.7.7",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    
    "dev-deploy": "npm run build && xcopy build\\* ..\\react-spring-blog-backend\\src\\main\\resources\\static\\ /E /Y /I",
    "dev-start": "npm run dev-deploy && cd ../react-spring-blog-backend && .\\gradlew.bat bootRun",
    "prod-deploy": "npm run build && xcopy build\\* ..\\react-spring-blog-backend\\src\\main\\resources\\static\\ /E /Y /I && cd ../react-spring-blog-backend && .\\gradlew.bat build",
    "clean": "rmdir /s /q build && cd ../react-spring-blog-backend && .\\gradlew.bat clean",
    "clean-deploy": "npm run clean && npm run prod-deploy",
    
    "dev-manual": "npm run dev-deploy",
    "backend-run": "cd ../react-spring-blog-backend && .\\gradlew.bat bootRun"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}